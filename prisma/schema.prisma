// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Partner {
  id        Int      @id @default(autoincrement())
  type      String   @default("매출처") // '매입처', '매출처', '협력사'
  name      String   @unique
  manager   String?
  email     String?
  phone     String?
  tel       String?
  fax       String?
  specialty String   // Comma-separated string for tags
  address   String?
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogFolder {
  id        Int         @id @default(autoincrement())
  name      String
  photos    BlogPhoto[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model BlogPhoto {
  id        Int        @id @default(autoincrement())
  url       String
  folderId  Int
  folder    BlogFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

model Order {
  id           Int      @id @default(autoincrement())
  partnerName String
  partnerId   Int?
  itemName    String
  quantity    Int      @default(1)
  orderDate   String?  // 'YYYY-MM-DD'
  dueDate     String?  // 'YYYY-MM-DD'
  status      String   @default("진행중") // '진행중', '납기임박', '완료'
  processSteps String  // JSON String: [{"name":"설계","status":"완료","active":true}, ...]
  memo        String?
  projectNo   String?
  drawingUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Estimate {
  id              Int      @id @default(autoincrement())
  docNo           String   @unique
  partnerName     String
  partnerId       Int?
  projectName     String
  quantity        Int?     @default(1)
  date            String   // 'YYYY-MM-DD'
  deliveryTerm    String?
  paymentTerm     String?
  validity        String?
  items           String   // JSON String
  subtotal        Float    @default(0)
  vat             Float    @default(0)
  totalAmount     Float    @default(0)
  amountInKorean  String?
  status          String   @default("견적중") // '견적중', '견적완료', '수주성공', '수주취소'
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 견적관리 파일 보드: 드래그로 올린 견적서 파일(PDF·엑셀) 한 건
model EstimateFile {
  id           Int               @id @default(autoincrement())
  fileName     String            // 원본 파일 이름
  mimeType     String?
  fileSize     Int               @default(0)
  projectName  String            // 공사명 (카드 제목)
  partnerName  String?
  quantity     Int               @default(1)
  amount       Float?            // 최종 합계 금액
  estimateDate String?           // 'YYYY-MM-DD'
  deliveryTerm String?           // 납품기한
  processSteps String            @default("[]") // JSON: 진행할 공정 이름 목록 ["설계","절단",...]
  status       String            @default("견적중") // '견적중', '견적완료', '수주성공', '수주취소'
  orderId      Int?              // 발주로 만든 공정관리(Order) id
  projectNo    String?           // 발주로 만든 프로젝트 번호 (PRJ-xxx)
  memo         String?
  content      EstimateFileData?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// 견적서 파일 내용 (목록 조회 때 같이 읽지 않도록 따로 보관)
model EstimateFileData {
  id     Int          @id @default(autoincrement())
  fileId Int          @unique
  file   EstimateFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  data   Bytes
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("기타")
  desc      String?
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isAllDay    Boolean  @default(false) @map("is_all_day")
  colorTag    String   @default("blue") @map("color_tag")
  category    String   @default("일반")
  authorName  String?  @map("author_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("schedules")
}

