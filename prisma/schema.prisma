// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Partner {
  id        Int      @id @default(autoincrement())
  type      String   @default("매출처") // '매입처', '매출처', '협력사'
  name      String   @unique
  manager   String?
  email     String?
  phone     String?
  tel       String?
  fax       String?
  specialty String   // Comma-separated string for tags
  address   String?
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogFolder {
  id        Int         @id @default(autoincrement())
  name      String
  photos    BlogPhoto[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model BlogPhoto {
  id        Int        @id @default(autoincrement())
  url       String
  folderId  Int
  folder    BlogFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

model Order {
  id           Int      @id @default(autoincrement())
  partnerName String
  partnerId   Int?
  itemName    String
  quantity    Int      @default(1)
  orderDate   String?  // 'YYYY-MM-DD'
  dueDate     String?  // 'YYYY-MM-DD'
  status      String   @default("진행중") // '진행중', '납기임박', '완료'
  processSteps String  // JSON String: [{"name":"설계","status":"완료","active":true}, ...]
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Estimate {
  id              Int      @id @default(autoincrement())
  docNo           String   @unique
  partnerName     String
  partnerId       Int?
  projectName     String
  quantity        Int?     @default(1)
  date            String   // 'YYYY-MM-DD'
  deliveryTerm    String?
  paymentTerm     String?
  validity        String?
  items           String   // JSON String
  subtotal        Float    @default(0)
  vat             Float    @default(0)
  totalAmount     Float    @default(0)
  amountInKorean  String?
  status          String   @default("견적중") // '견적중', '견적완료', '수주성공', '수주취소'
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
